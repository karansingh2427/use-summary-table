# Ignore macOS metadata
.DS_Store
**/.DS_Store

# Ignore any accidentally downloaded test files outside samples/
*.pdf
!samples/*.pdf

# Editor directories
.vscode/
.idea/

# Python bytecode cache
__pycache__/
*.pyc

# Cloudflare local dev
.dev.vars
.wrangler/

# Node modules (if added)
node_modules/
npm-debug.log
yarn-error.log

# Logs
*.log
